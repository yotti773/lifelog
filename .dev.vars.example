GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
# APIの共有トークン(Issue #87)。本番はwrangler secret putで登録し、アプリの設定画面に同じ値を入力する。
# この行自体が無い場合は認証を要求しない(ローカル開発用)。
# 逆に、行は在るのに値が空("" や ",")の場合は全拒否になる — 手編集で最後の1本を抜いたときに
# APIが黙って全開放されるのを防ぐため(Issue #218)。全員を止めたいときは空にせず、
# 誰にも渡していない新しい値に差し替えること
#
# カンマ区切りで複数指定できる(Issue #218)。配布先ごとに別のトークンを発行しておくと、
# その1本をこの値から外すだけで、その人だけを失効させられる(他の人は影響を受けない)。
#   例) API_AUTH_TOKEN=token-for-me,token-for-alice,token-for-bob
# 文字列の完全一致で照合するため、各トークンは十分な長さのランダム値にすること。
# 誰にどのトークンを渡したかはリポジトリ・Issueに書かない(手元で管理する)。
API_AUTH_TOKEN=your-random-token-here
