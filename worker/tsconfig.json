{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // wranglerRouting.test.ts はデプロイ設定(wrangler.toml)を node:fs で読むテストで、
  // Workersランタイムの世界には属さない。ここに `"node"` 型を足して通すと、
  // Worker本体のコードでもNode APIが型エラーにならなくなる(nodejs_compatは未有効)ため、
  // 型検査は tsconfig.node.json 側に持たせて、こちらからは外す
  "exclude": ["__tests__/wranglerRouting.test.ts"]
}
